# 对话剧场 / Dialogue Theater 环境变量示例
# 复制本文件为 .env 后填入真实值; .env 已加入 .gitignore,不会提交到仓库。

# ---------- 后端核心配置 ----------

# 并发录制 worker 数
WORKER_COUNT=2

# 日志级别: debug / info / warning / error
LOG_LEVEL=info

# 单文件上传大小上限(字节);importer 也复用此值作为 zip 内单文件上限
MAX_UPLOAD_SIZE=10485760

# 生产必须 true;本地 dev 可设 false 跳过鉴权
AUTH_REQUIRED=false

# 上传资源转绝对 URL;部署到域名时修改
BASE_URL=http://localhost:8000

# ---------- zip 导入配置 ----------

# zip 本体上限(默认 200MB);nginx client_max_body_size 需 ≥ 此值 + buffer
IMPORT_MAX_ZIP_SIZE=209715200

# 解压后总上限(默认 500MB)
IMPORT_MAX_UNPACKED_SIZE=524288000

# ---------- AI 辅助生成配置 ----------

# OpenAI 兼容 API Key;未配置时 AI 生成不可用
AI_API_KEY=

# OpenAI 兼容 API 基础 URL
AI_BASE_URL=https://api.openai.com/v1

# 使用的模型
AI_MODEL=gpt-4o-mini

# 单次生成最大 token 数
AI_MAX_TOKENS=4096

# 生成温度(0-2)
AI_TEMPERATURE=0.8

# 每用户每日 AI 调用额度(内存计数,重启清零)
AI_DAILY_LIMIT=50

# AI 接口超时时间(秒)
AI_TIMEOUT_SECONDS=60

# ---------- TTS 多角色对话合成配置(2025-Q3) ----------
# 详见 docs/Qwen3-TTS_MultiSpeaker_Dialogue_Guide.md。
# 模型未配置 / 路径为空时,/api/tts/* 一律返回 503,后端照常启动。

# TTS 全局开关;默认 true。设 false 时 /api/tts/* 全 503
TTS_ENABLED=true

# 本地 Qwen3-TTS 模型绝对路径(必填)
# Windows 示例:D:\Models\Qwen3-TTS-12Hz-1.7B-CustomVoice
# Linux 示例:/opt/models/Qwen3-TTS-12Hz-1.7B-CustomVoice
TTS_MODEL_PATH=

# 推理设备: cuda:0 / cpu(显存不够时降 cpu)
TTS_DEVICE=cuda:0

# 模型精度: bfloat16 / float16 / float32(精度越低显存越省)
TTS_DTYPE=bfloat16

# 输出采样率(Hz);与原 ASR 时间轴对齐建议 24000
TTS_TARGET_SR=24000

# 音色/角色/语气配置文件路径;不存在时回退内置默认 + 警告
# 相对路径,从 backend/ 启动 uvicorn 时走这条;Docker 容器内 WORKDIR=/app 下同样有效。
# backend/config/tts_voices.json.example 是模板,复制去掉 .example
TTS_VOICE_CONFIG=config/tts_voices.json

# TTS language 参数(Qwen3-TTS 多语言支持,中文场景填 Chinese)
TTS_LANGUAGE=Chinese

# 单段推理超时(秒);超时回退静音 + 写 metadata,不抛错
TTS_INFERENCE_TIMEOUT_S=120
