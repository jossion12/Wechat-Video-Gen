# 对话剧场 / Dialogue Theater 环境变量示例
# 复制本文件为 .env 后填入真实值; .env 已加入 .gitignore,不会提交到仓库。

# ---------- 后端核心配置 ----------

# 并发录制 worker 数
WORKER_COUNT=2

# 日志级别: debug / info / warning / error
LOG_LEVEL=info

# 单文件上传大小上限(字节);importer 也复用此值作为 zip 内单文件上限
MAX_UPLOAD_SIZE=10485760

# 生产必须 true;本地 dev 可设 false 跳过鉴权
AUTH_REQUIRED=false

# 上传资源转绝对 URL;部署到域名时修改
BASE_URL=http://localhost:8000

# ---------- zip 导入配置 ----------

# zip 本体上限(默认 200MB);nginx client_max_body_size 需 ≥ 此值 + buffer
IMPORT_MAX_ZIP_SIZE=209715200

# 解压后总上限(默认 500MB)
IMPORT_MAX_UNPACKED_SIZE=524288000

# ---------- AI 辅助生成配置 ----------

# OpenAI 兼容 API Key;未配置时 AI 生成不可用
AI_API_KEY=

# OpenAI 兼容 API 基础 URL
AI_BASE_URL=https://api.openai.com/v1

# 使用的模型
AI_MODEL=gpt-4o-mini

# 单次生成最大 token 数
AI_MAX_TOKENS=4096

# 生成温度(0-2)
AI_TEMPERATURE=0.8

# 每用户每日 AI 调用额度(内存计数,重启清零)
AI_DAILY_LIMIT=50

# AI 接口超时时间(秒)
AI_TIMEOUT_SECONDS=60
