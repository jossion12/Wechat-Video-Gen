<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<title>Dialogue Theater — Noir</title>
<style>
  /* ---- 基础 / 黑白胶片 ---- */
  * { margin: 0; padding: 0; box-sizing: border-box; -webkit-font-smoothing: antialiased; }
  :root {
    --bg: {{ background }};
    --paper: #f5f0e1;
    --ink: #0a0a0a;
    --ink-soft: #2a2a2a;
    --grey: #666666;
    --grey-light: #cccccc;
    --self-bg: #0a0a0a;
    --self-text: #f5f0e1;
    --other-bg: #ffffff;
    --other-text: #0a0a0a;
    --reply-bar: #0a0a0a;
  }
  html, body { overflow: hidden; background: var(--bg); }
  body {
    width: 1080px; height: 1920px; position: relative; color: var(--ink);
    display: flex; flex-direction: column;
    font-family: "Source Serif Pro", "Georgia", "Noto Serif CJK SC", "STSong", "SimSun", serif;
    opacity: {{ opacity }};
  }

  /* 背景层：用户图 → 颗粒 → 暗角 → 齿孔（均位于 z-index 0 以下或 0） */
  {% if background_image_url %}
  body::before {
    content: ""; position: absolute; inset: 0;
    background-image: url('{{ background_image_url }}');
    background-size: cover; background-position: center;
    opacity: 0.15; pointer-events: none; z-index: 0;
  }
  {% endif %}

  .bg-layer { position: absolute; inset: 0; pointer-events: none; z-index: 0; }
  .bg-grain {
    filter: url(#grain);
    opacity: 0.10;
  }
  .bg-vignette {
    background: radial-gradient(ellipse at center, transparent 60%, rgba(0,0,0,0.35) 100%);
  }
  .bg-perf {
    top: 0; bottom: 0; width: 80px;
    background: repeating-linear-gradient(
      to bottom,
      transparent 0 30px,
      var(--ink) 30px 46px,
      transparent 46px 80px
    );
  }
  .bg-perf-left { left: 0; }
  .bg-perf-right { right: 0; }

  /* ---- 声明卡 ---- */
  .disclaimer-card {
    position: absolute; inset: 0;
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    background: var(--ink);
    z-index: 10000; opacity: 1;
    transition: opacity 0.5s ease-out;
  }
  .disclaimer-card.hide { opacity: 0; pointer-events: none; }
  .disclaimer-grain {
    position: absolute; inset: 0; filter: url(#grain); opacity: 0;
    animation: grain-in 0.3s ease-out 0.3s forwards;
  }
  @keyframes grain-in { to { opacity: 0.15; } }
  .disclaimer-text-wrap {
    overflow: hidden;
    font-family: "Playfair Display", "Times New Roman", "Noto Serif CJK SC", "STSong", "SimSun", serif;
    font-size: 38px; color: #ffffff; letter-spacing: 4px;
    z-index: 1;
  }
  .disclaimer-text {
    display: inline-block; white-space: nowrap;
    clip-path: inset(0 100% 0 0);
    animation: typewrite 0.3s steps(20) 0.6s forwards;
  }
  @keyframes typewrite { to { clip-path: inset(0 0 0 0); } }

  /* ---- 顶部标题栏 ---- */
  .theater-header {
    height: 200px; flex: none;
    display: flex; align-items: center; justify-content: center;
    padding: 0 120px; position: relative; z-index: 10000;
  }
  .title-wrap {
    display: flex; flex-direction: column; align-items: center; gap: 12px;
    max-width: 840px;
  }
  .theater-title {
    font-family: "Playfair Display", "Times New Roman", "Noto Serif CJK SC", "STSong", "SimSun", serif;
    font-size: 64px; font-weight: 700; font-style: italic;
    color: var(--ink); text-align: center; letter-spacing: 2px;
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    max-width: 100%;
  }
  .theater-title.typewriter::after {
    content: "";
    display: inline-block;
    width: 4px;
    height: 0.8em;
    background: currentColor;
    margin-left: 8px;
    vertical-align: middle;
    animation: cursor-blink 0.7s step-end infinite;
  }
  .title-line { background: var(--ink); }
  .title-line--full { width: 100%; height: 1px; }
  .title-line--short { width: 160px; height: 1px; opacity: 0.5; }

  /* ---- 聊天区 ---- */
  .chat-wrap { flex: 1; min-height: 0; overflow: hidden; position: relative; z-index: 10; }
  .chat-inner {
    display: flex; flex-direction: column; gap: 32px;
    padding: 36px 120px 60px; min-height: 100%;
    transition: transform 0.5s ease-out;
    will-change: transform;
  }

  /* ---- 时间戳 / 幕间字幕 ---- */
  .time-stamp {
    align-self: center;
    background: transparent; color: var(--ink-soft);
    font-size: 22px; font-style: italic; letter-spacing: 1px;
    opacity: 0; transform: translateY(10px);
    transition: opacity .35s ease-out, transform .35s ease-out;
  }
  .time-stamp.show { opacity: 1; transform: translateY(0); }

  .sys-msg {
    align-self: center; width: 100%; max-width: 90%;
    display: flex; align-items: center; justify-content: center; gap: 16px;
    opacity: 0; transform: translateY(20px) scale(0.96);
    transition: opacity .5s ease-out, transform .5s ease-out;
  }
  .sys-msg.show { opacity: 1; transform: translateY(0) scale(1); }
  .sys-reel {
    font-size: 18px; font-style: italic; color: var(--grey); letter-spacing: 1px;
    flex: none;
  }
  .sys-line { width: 30%; height: 1px; background: var(--ink); }
  .sys-text {
    flex: none; font-family: "Playfair Display", "Times New Roman", "Noto Serif CJK SC", "STSong", "SimSun", serif;
    font-size: 26px; font-style: italic; text-transform: uppercase;
    color: var(--ink); letter-spacing: 0.15em; text-align: center;
  }

  /* ---- 消息行 ---- */
  .msg {
    display: flex; gap: 24px; max-width: 84%; align-self: flex-start;
    opacity: 0; transform: translateY(20px);
    transition: opacity .3s ease-out, transform .3s ease-out;
  }
  .msg.show { opacity: 1; transform: translateY(0); }

  /* 圆角正方形头像 */
  .avatar {
    width: 96px; height: 96px; flex: none;
    background-size: cover; background-position: center;
    background-color: #ffffff;
    border-radius: 8px;
    display: flex; align-items: center; justify-content: center;
    font-family: "Playfair Display", "Times New Roman", "Noto Serif CJK SC", "STSong", "SimSun", serif;
    font-size: 56px; font-weight: 700; color: var(--ink);
    border: 2px solid var(--ink);
  }
  .avatar-default { background: #ffffff; }

  .msg .body { display: flex; flex-direction: column; align-items: flex-start; min-width: 0; }
  .sender-row { display: flex; align-items: center; gap: 12px; margin-bottom: 10px; }
  .sender { font-size: 24px; color: var(--ink-soft); font-style: italic; }

  /* 气泡 */
  .bubble {
    position: relative; max-width: 100%;
    padding: 24px 30px; font-size: 40px; line-height: 1.45;
    color: var(--other-text); word-break: break-word;
    background: var(--other-bg);
    border: 1px solid var(--ink); border-radius: 4px;
    box-shadow: 0 2px 12px rgba(0,0,0,0.45);
  }

  /* 自己(右侧,纯黑反色) */
  .msg.self { flex-direction: row-reverse; align-self: flex-end; }
  .msg.self .body { align-items: flex-end; }
  .msg.self {
    opacity: 1; transform: scaleY(0); transform-origin: bottom;
    transition: transform .3s ease-out;
  }
  .msg.self.show { transform: scaleY(1); }
  .msg.self .bubble {
    background: var(--self-bg); color: var(--self-text);
    border: none; border-radius: 4px;
    box-shadow: 0 2px 12px rgba(0,0,0,0.45);
  }
  .msg.self .sender-row { display: none; }

  /* 单独表情消息 */
  .msg.emoji .bubble { background: transparent !important; border: none !important; box-shadow: none !important; padding: 0; }
  .emoji-text { font-size: 130px; line-height: 1; filter: grayscale(1) contrast(1.1); display: inline-block; border: 1px solid var(--ink); }
  .msg.emoji.self { align-self: flex-end; }

  /* 图片消息 */
  .img-bubble { padding: 14px; background: transparent; }
  .img-wrap { overflow: hidden; border-radius: 8px; border: 1px solid var(--ink); }
  .img-wrap img { display: block; max-width: 500px; max-height: 680px;
                  width: auto; height: auto; border-radius: 8px; object-fit: contain;
                  filter: grayscale(1) contrast(1.1) brightness(0.95); }
  .img-caption { padding: 16px 6px 4px; font-size: 36px; line-height: 1.4;
                 color: var(--ink); max-width: 480px; word-break: break-word; }

  /* 视频消息 */
  .video-bubble { padding: 0; overflow: hidden; border-radius: 8px;
                  position: relative; max-width: 500px; background: var(--ink);
                  border: 1px solid var(--ink); box-shadow: 0 2px 12px rgba(0,0,0,0.45); }
  .video-bubble .video-cover { display: block; width: 500px; min-height: 280px;
                               max-height: 680px; object-fit: cover; border-radius: 8px;
                               filter: grayscale(1) contrast(1.1) brightness(0.95); }
  .video-play { position: absolute; left: 50%; top: 50%;
                width: 96px; height: 96px; background: #000000;
                border-radius: 50%; transform: translate(-50%, -50%);
                display: flex; align-items: center; justify-content: center;
                border: 2px solid #ffffff; }
  .video-play::before { content: ""; width: 0; height: 0;
    border-left: 34px solid #ffffff; border-top: 22px solid transparent;
    border-bottom: 22px solid transparent; margin-left: 10px; }
  .video-duration { position: absolute; right: 18px; bottom: 18px;
                    background: rgba(255,255,255,0.85); color: var(--ink);
                    font-size: 26px; padding: 4px 12px; border-radius: 4px; }

  /* ---- 回复引用 ---- */
  .reply-quote {
    margin-bottom: 10px;
    padding: 10px 18px;
    border-radius: 4px;
    background: rgba(0,0,0,0.06);
    border-left: 3px solid var(--reply-bar);
    max-width: 100%;
  }
  .reply-quote-sender { font-size: 22px; font-weight: 700; font-style: italic; color: var(--ink); margin-bottom: 4px; }
  .reply-quote-text { font-size: 26px; color: var(--ink-soft); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .msg.self .reply-quote { border-left: none; border-right: 3px solid var(--reply-bar); }

  /* ---- AI 角标 ---- */
  .ai-badge {
    position: absolute; right: 28px; bottom: 28px; z-index: 9999;
    pointer-events: none; user-select: none;
  }
  .ai-badge.minimal {
    width: 64px; height: 64px; border-radius: 50%;
    background: #ffffff; border: 2px solid var(--ink);
    display: flex; align-items: center; justify-content: center;
    font-family: "Playfair Display", "Times New Roman", "Noto Serif CJK SC", "STSong", "SimSun", serif;
    font-size: 0; color: transparent;
  }
  .ai-badge.minimal::before {
    content: "AI"; font-size: 28px; font-weight: 700; color: var(--ink);
    letter-spacing: 0; text-transform: uppercase;
  }
  .ai-badge.retro {
    color: #ffffff; background: var(--ink);
    border: 2px solid var(--ink); font-weight: 700; text-transform: uppercase;
    padding: 10px 22px; font-size: 24px; letter-spacing: 2px;
  }
  .ai-badge.neon {
    color: var(--ink); border: 2px solid var(--ink);
    background: rgba(255,255,255,0.85);
    padding: 10px 22px; font-size: 24px; letter-spacing: 2px;
  }

  /* ---- 开头特效 ---- */
  .intro-overlay {
    position: absolute; inset: 0; z-index: 9000;
    display: flex; align-items: center; justify-content: center;
    pointer-events: none; opacity: 1;
  }
  .intro-overlay.done { display: none; }

  /* scanline-reveal：顶部线条从左向右展开，随后带着下边缘向下揭开整个画面，最后消失 */
  .intro-line {
    position: absolute; top: 0; left: 0;
    width: 0; height: 4px;
    background: var(--ink);
    box-shadow: 0 0 12px rgba(255,255,255,0.35);
    z-index: 2;
  }
  .intro-mask {
    position: absolute; inset: 0;
    background: var(--bg);
    clip-path: inset(0 0 0 0);
    z-index: 1;
  }
  .intro-overlay.start .intro-line {
    animation: scanline-grow 0.25s ease-out forwards,
               scanline-sweep 1.5s ease-out 0.25s forwards;
  }
  .intro-overlay.start .intro-mask { animation: scanline-open 1.5s ease-out 0.25s forwards; }
  @keyframes scanline-grow { to { width: 100%; } }
  @keyframes scanline-open { to { clip-path: inset(100% 0 0 0); } }
  @keyframes scanline-sweep {
    0% { top: 0; opacity: 1; }
    85% { top: 100%; opacity: 1; }
    100% { top: 100%; opacity: 0; }
  }

  /* typewriter-title */
  .intro-overlay.typewriter { background: rgba(10,10,10,0.88); }
  .intro-typewriter { text-align: center; z-index: 2; }
  .intro-overlay.typewriter.fade-out { animation: typewriter-fade 0.3s ease-out forwards; }
  @keyframes cursor-blink { 50% { opacity: 0; } }
  @keyframes typewriter-fade { to { opacity: 0; } }
</style>
</head>
<body>
  <!-- 内嵌 SVG 颗粒滤镜 -->
  <svg style="position:absolute;width:0;height:0">
    <filter id="grain">
      <feTurbulence type="fractalNoise" baseFrequency="0.9" numOctaves="2" stitchTiles="stitch"/>
      <feColorMatrix type="saturate" values="0"/>
    </filter>
  </svg>

  <!-- 背景装饰层 -->
  <div class="bg-layer bg-grain"></div>
  <div class="bg-layer bg-vignette"></div>
  <div class="bg-layer bg-perf bg-perf-left"></div>
  <div class="bg-layer bg-perf bg-perf-right"></div>

  <!-- 片头声明卡 -->
  <div class="disclaimer-card" id="__disclaimer__">
    <div class="disclaimer-grain"></div>
    <div class="disclaimer-text-wrap">
      <span class="disclaimer-text">{{ disclaimer_text }}</span>
    </div>
  </div>

  {% if intro_effect != "none" %}
  <!-- 开头特效层 -->
  <div class="intro-overlay intro-{{ intro_effect }}" id="__intro__">
    {% if intro_effect == "scanline" %}
      <div class="intro-line"></div>
      <div class="intro-mask"></div>
    {% elif intro_effect == "typewriter" %}
      <div class="intro-typewriter"></div>
    {% endif %}
  </div>
  {% endif %}

  <!-- 顶部标题栏 -->
  <div class="theater-header">
    <div class="title-wrap">
      <div class="theater-title" id="theater-title"></div>
      <div class="title-line title-line--full"></div>
      <div class="title-line title-line--short"></div>
    </div>
  </div>

  <!-- 聊天区 -->
  <div class="chat-wrap" id="chat-wrap">
    <div class="chat-inner" id="chat-inner">
      {% macro reply_quote(m) %}
        {% if m.reply_to_dom_id %}
          <div class="reply-quote" data-reply-to="{{ m.reply_to_dom_id }}">
            <div class="reply-quote-sender">{{ m.reply_to_sender_name }}</div>
            <div class="reply-quote-text">{{ m.reply_to_text[:30] }}{% if (m.reply_to_text | length) > 30 %}…{% endif %}</div>
          </div>
        {% endif %}
      {% endmacro %}
      {% for m in messages %}
        {% if m.kind == 'sys' %}
          <div class="sys-msg" id="{{ m.dom_id }}">
            <span class="sys-reel">REEL {{ "%02d"|format(m.dom_id[1:]|int) }}</span>
            <div class="sys-line"></div>
            <div class="sys-text">{{ m.text }}</div>
            <div class="sys-line"></div>
          </div>
        {% elif m.kind == 'timestamp' %}
          <div class="time-stamp" id="{{ m.dom_id }}">{{ m.text }}</div>
        {% elif m.kind == 'emoji' %}
          <div class="msg emoji {{ m.css_class }}" id="{{ m.dom_id }}">
            {% if m.sender_avatar %}
              <div class="avatar" style="background-image: url('{{ m.sender_avatar }}');"></div>
            {% else %}
              <div class="avatar avatar-default">{{ m.sender_name[0] if m.sender_name else '?' }}</div>
            {% endif %}
            <div class="body">
              {% if m.show_name %}<div class="sender-row"><span class="sender">{{ m.sender_name }}</span></div>{% endif %}
              {{ reply_quote(m) }}
              <div class="bubble"><span class="emoji-text">{{ m.text }}</span></div>
            </div>
          </div>
        {% elif m.kind == 'image' %}
          <div class="msg {{ m.css_class }}" id="{{ m.dom_id }}">
            {% if m.sender_avatar %}
              <div class="avatar" style="background-image: url('{{ m.sender_avatar }}');"></div>
            {% else %}
              <div class="avatar avatar-default">{{ m.sender_name[0] if m.sender_name else '?' }}</div>
            {% endif %}
            <div class="body">
              {% if m.show_name %}<div class="sender-row"><span class="sender">{{ m.sender_name }}</span></div>{% endif %}
              {{ reply_quote(m) }}
              <div class="bubble img-bubble">
                <div class="img-wrap"><img src="{{ m.image_url }}" alt="{{ m.text or '' }}"></div>
                {% if m.text %}<div class="img-caption">{{ m.text }}</div>{% endif %}
              </div>
            </div>
          </div>
        {% elif m.kind == 'video' %}
          <div class="msg {{ m.css_class }}" id="{{ m.dom_id }}">
            {% if m.sender_avatar %}
              <div class="avatar" style="background-image: url('{{ m.sender_avatar }}');"></div>
            {% else %}
              <div class="avatar avatar-default">{{ m.sender_name[0] if m.sender_name else '?' }}</div>
            {% endif %}
            <div class="body">
              {% if m.show_name %}<div class="sender-row"><span class="sender">{{ m.sender_name }}</span></div>{% endif %}
              {{ reply_quote(m) }}
              <div class="bubble video-bubble">
                <img class="video-cover" src="{{ m.cover_url or m.video_url }}" alt="">
                <div class="video-play"></div>
                <div class="video-duration">{{ m.duration }}</div>
              </div>
            </div>
          </div>
        {% else %}
          <div class="msg {{ m.css_class }}" id="{{ m.dom_id }}">
            {% if m.sender_avatar %}
              <div class="avatar" style="background-image: url('{{ m.sender_avatar }}');"></div>
            {% else %}
              <div class="avatar avatar-default">{{ m.sender_name[0] if m.sender_name else '?' }}</div>
            {% endif %}
            <div class="body">
              {% if m.show_name %}<div class="sender-row"><span class="sender">{{ m.sender_name }}</span></div>{% endif %}
              {{ reply_quote(m) }}
              <div class="bubble">{{ m.text | replace('\n', '<br>') | safe }}</div>
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>

  <!-- AI 角标 -->
  <div class="ai-badge {{ ai_badge_style }}">{{ watermark_text }}</div>

<script>
  const TIMELINE = {{ timeline | tojson }};
  const TYPEWRITER_TITLE = {{ title | tojson }};
  const TYPEWRITER_INITIAL_MS = {{ typewriter_initial_ms }};
  const TYPEWRITER_PER_CHAR_MS = {{ typewriter_per_char_ms }};
  const chatWrap = document.getElementById('chat-wrap');
  const chatInner = document.getElementById('chat-inner');

  function typewriteTitle(el, text, initialMs, perCharMs, onDone) {
    el.textContent = '';
    setTimeout(() => {
      let i = 0;
      function next() {
        if (i < text.length) {
          el.textContent += text[i];
          i++;
          setTimeout(next, perCharMs);
        } else if (onDone) {
          onDone();
        }
      }
      next();
    }, initialMs);
  }

  function currentShift() {
    const m = chatInner.style.transform.match(/translateY\((-?[\d.]+)px\)/);
    return m ? parseFloat(m[1]) : 0;
  }

  function scrollToShow(el) {
    if (!el) return;
    const wrapRect = chatWrap.getBoundingClientRect();
    const elRect = el.getBoundingClientRect();
    const overflow = elRect.bottom - wrapRect.bottom;
    if (overflow > 0) {
      chatInner.style.transform = 'translateY(-' + (Math.abs(currentShift()) + overflow) + 'px)';
    }
  }

  function autoScroll(el) {
    if (!el) return;
    scrollToShow(el);
    el.querySelectorAll('img').forEach(img => {
      if (!img.complete) {
        img.addEventListener('load', () => scrollToShow(el), { once: true });
      }
    });
  }

  window.addEventListener('load', () => {
    setTimeout(() => {
      TIMELINE.forEach(t => setTimeout(() => {
        const el = document.getElementById(t.id);
        if (!el) return;
        if (t.type === 'disclaimer') {
          el.classList.add('hide');
          return;
        }
        if (t.type === 'intro') {
          el.classList.add('start');
          if (el.classList.contains('intro-typewriter')) {
            const headerTitleEl = document.getElementById('theater-title');
            headerTitleEl.classList.add('typewriter');
            typewriteTitle(headerTitleEl, TYPEWRITER_TITLE, TYPEWRITER_INITIAL_MS, TYPEWRITER_PER_CHAR_MS, () => {
              headerTitleEl.classList.remove('typewriter');
              el.classList.add('fade-out');
              setTimeout(() => el.classList.add('done'), 300);
            });
          } else {
            setTimeout(() => el.classList.add('done'), {{ intro_duration_ms }});
          }
          return;
        }
        el.classList.add('show');
        setTimeout(() => autoScroll(el), 250);
      }, t.at));
    }, 300);
  });
</script>
</body>
</html>
