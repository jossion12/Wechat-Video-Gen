<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<title>Dialogue Theater — Green Screen</title>
<style>
  /* ---- 绿幕抠像 ---- */
  /* 整页背景为纯 #00ff00,便于后期抠像。
     顶部标题、声明卡都使用绿色背景 + 黑色字,抠像后会一并消失;
     只留下黑底/白底的高对比气泡。 */
  * { margin: 0; padding: 0; box-sizing: border-box; -webkit-font-smoothing: antialiased; }
  :root {
    {% if background_visible %}--bg: #00ff00;{% endif %}
    --self-bg: #0a0a0a;     /* 自己气泡:近黑底白字 */
    --other-bg: #ffffff;    /* 他人气泡:纯白底黑字 */
    --self-fg: #ffffff;
    --other-fg: #000000;
    --border: #000000;
  }
  html, body { overflow: hidden; {% if background_visible %}background: #00ff00;{% endif %} }
  body {
    width: 1080px; height: 1920px; position: relative; color: #000000;
    display: flex; flex-direction: column;
    font-family: system-ui, -apple-system, 'PingFang SC', 'Microsoft YaHei', sans-serif;
    opacity: {{ opacity }};
  }

  /* ---- 声明卡 ---- */
  /* 1 秒后 fade 成同色背景,抠像后整张卡片消失 */
  .disclaimer-card {
    position: absolute; inset: 0;
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    background: #00ff00;
    z-index: 10000; opacity: 1;
    transition: opacity 0.4s ease-out;
  }
  .disclaimer-card.hide { opacity: 0; pointer-events: none; }
  .disclaimer-title {
    font-size: 96px; font-weight: 900; letter-spacing: 4px;
    color: #000000; margin-bottom: 32px;
  }
  .disclaimer-text {
    font-size: 34px; color: #000000; letter-spacing: 1px;
    text-align: center; line-height: 1.5; padding: 0 80px;
  }

  /* ---- 顶部标题栏 ---- */
  /* 绿色背景 + 黑字,抠像后整条标题栏消失 */
  .theater-header {
    height: 120px; flex: none;
    display: flex; align-items: center; justify-content: center;
    padding: 0 40px; position: relative; z-index: 10000;
    background: #00ff00;
  }
  .theater-title {
    font-size: 40px; font-weight: 700; letter-spacing: 2px;
    color: #000000; text-align: center;
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  }
  .theater-title.typewriter::after {
    content: "";
    display: inline-block;
    width: 4px;
    height: 0.8em;
    background: currentColor;
    margin-left: 8px;
    vertical-align: middle;
    animation: cursor-blink 0.7s step-end infinite;
  }

  /* ---- 聊天区 ---- */
  .chat-wrap { flex: 1; min-height: 0; overflow: hidden; position: relative; z-index: 10; }
  .chat-inner {
    display: flex; flex-direction: column; gap: 32px;
    padding: 36px 40px 60px; min-height: 100%;
    transition: transform 0.5s ease-out;
    will-change: transform;
  }

  /* ---- 时间戳 / 幕间字幕 ---- */
  /* 黑字、无背景,抠像后时间码浮在任意背景上都清晰 */
  .time-stamp {
    align-self: center;
    color: #000000;
    font-size: 26px; letter-spacing: 1px;
    padding: 8px 16px;
    opacity: 0; transform: translateY(10px);
    transition: opacity .35s ease-out, transform .35s ease-out;
  }
  .time-stamp.show { opacity: 1; transform: translateY(0); }

  .sys-msg {
    align-self: center; max-width: 80%;
    color: #000000;
    font-size: 30px; line-height: 1.5; text-align: center;
    padding: 8px 16px;
    opacity: 0; transform: translateY(20px);
    transition: opacity .5s ease-out, transform .5s ease-out;
  }
  .sys-msg.show { opacity: 1; transform: translateY(0); }

  /* ---- 消息行 ---- */
  .msg {
    display: flex; gap: 20px; max-width: 86%; align-self: flex-start;
    opacity: 0; transform: translateY(30px);
    transition: opacity .4s ease-out, transform .4s ease-out;
  }
  .msg.show { opacity: 1; transform: translateY(0); }

  /* 头像 —— 留给后期;默认占位用纯黑块 */
  .avatar {
    width: 88px; height: 88px; flex: none;
    background-size: cover; background-position: center;
    background-color: #000000;
    display: flex; align-items: center; justify-content: center;
    font-size: 36px; font-weight: 800; color: #ffffff;
    border: 1px solid #000000;
  }
  .avatar-default { background: #000000; color: #ffffff; }

  .msg .body { display: flex; flex-direction: column; align-items: flex-start; min-width: 0; }
  .sender-row { display: flex; align-items: center; gap: 12px; margin-bottom: 8px; }
  .sender { font-size: 24px; color: #000000; }

  /* 气泡 —— 高对比黑白;任何合成背景都能清晰看见 */
  .bubble {
    position: relative; max-width: 100%;
    padding: 22px 28px; font-size: 40px; line-height: 1.4;
    word-break: break-word;
    background: var(--other-bg);
    color: var(--other-fg);
    border: 1px solid var(--border);
  }

  /* 自己(右侧) */
  .msg.self { flex-direction: row-reverse; align-self: flex-end; }
  .msg.self .body { align-items: flex-end; }
  .msg.self .bubble {
    background: var(--self-bg);
    color: var(--self-fg);
  }
  .msg.self .sender-row { display: none; }

  /* 单独表情消息 */
  .msg.emoji .bubble { background: transparent !important; border: none; padding: 0; }
  .msg.emoji .emoji-text { font-size: 120px; line-height: 1; }
  .msg.emoji.self { align-self: flex-end; }

  /* 图片消息 */
  .img-bubble { padding: 12px; background: #ffffff; border: 1px solid #000000; }
  .img-wrap { overflow: hidden; }
  .img-wrap img { display: block; max-width: 500px; max-height: 680px;
                  width: auto; height: auto; }
  .img-caption { padding: 12px 4px 2px; font-size: 34px; line-height: 1.4;
                 color: #000000; max-width: 480px; word-break: break-word; }

  /* 视频消息 */
  .video-bubble { padding: 0; overflow: hidden;
                  position: relative; max-width: 500px; background: #000000;
                  border: 1px solid #ffffff; }
  .video-bubble .video-cover { display: block; width: 500px; min-height: 280px;
                               max-height: 680px; object-fit: cover; }
  .video-play { position: absolute; left: 50%; top: 50%;
                width: 80px; height: 80px; background: #ffffff;
                transform: translate(-50%, -50%);
                display: flex; align-items: center; justify-content: center;
                border: 1px solid #000000; }
  .video-play::before { content: ""; width: 0; height: 0;
    border-left: 28px solid #000000; border-top: 18px solid transparent;
    border-bottom: 18px solid transparent; margin-left: 8px; }
  .video-duration { position: absolute; right: 14px; bottom: 14px;
                    background: #ffffff; color: #000000;
                    font-size: 26px; padding: 4px 10px;
                    border: 1px solid #000000; }

  /* ---- 回复引用 ---- */
  .reply-quote {
    margin-bottom: 10px;
    padding: 10px 18px;
    background: #ffffff;
    border-left: 4px solid #000000;
    max-width: 100%;
  }
  .reply-quote-sender { font-size: 22px; font-weight: 700; color: #000000; margin-bottom: 4px; }
  .reply-quote-text { font-size: 26px; color: #000000; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .msg.self .reply-quote { border-left: none; border-right: 4px solid #000000; }

  /* ---- AI 角标 ---- */
  /* minimal 风格用黑边白底;抠像后仍能看清 */
  .ai-badge {
    position: absolute; right: 28px; bottom: 28px; z-index: 9999;
    padding: 10px 20px; font-size: 24px; letter-spacing: 0;
    pointer-events: none; user-select: none;
    background: #ffffff; color: #000000;
    border: 1px solid #000000;
  }
  .ai-badge.neon { background: #ffffff; color: #000000; border-color: #000000; }
  .ai-badge.minimal { background: #ffffff; color: #000000; border-color: #000000; }
  .ai-badge.retro { background: #000000; color: #ffffff; border-color: #000000; }

  /* ---- 开头特效 ---- */
  /* 绿幕风格下隐藏所有装饰层,仅留文案(同样用绿色背景 + 黑字,
     抠像后消失)。未指定 none 时不显示整层覆盖。 */
  {% if intro_effect != "none" %}
  .intro-overlay {
    position: absolute; inset: 0; z-index: 9000;
    display: flex; align-items: center; justify-content: center;
    pointer-events: none; opacity: 1;
    background: #00ff00;
  }
  .intro-overlay.done { display: none; }

  /* scanline-reveal: 顶部黑线从左向右揭开 */
  .intro-line {
    position: absolute; top: 0; left: 0;
    width: 0; height: 8px;
    background: #000000;
    z-index: 2;
  }
  .intro-mask {
    position: absolute; inset: 0;
    background: #00ff00;
    clip-path: inset(0 0 0 0);
    z-index: 1;
  }
  .intro-overlay.start .intro-line {
    animation: scanline-grow 0.25s steps(12) forwards,
               scanline-sweep 1.5s steps(18) 0.25s forwards;
  }
  .intro-overlay.start .intro-mask { animation: scanline-open 1.5s steps(18) 0.25s forwards; }
  @keyframes scanline-grow { to { width: 100%; } }
  @keyframes scanline-open { to { clip-path: inset(100% 0 0 0); } }
  @keyframes scanline-sweep {
    0% { top: 0; opacity: 1; }
    85% { top: 100%; opacity: 1; }
    100% { top: 100%; opacity: 0; }
  }

  /* typewriter-title —— 整层绿色,标题黑字,抠像后消失 */
  .intro-overlay.typewriter { background: #00ff00; }
  .intro-typewriter { text-align: center; z-index: 2; }
  .intro-overlay.typewriter .intro-typewriter-text {
    color: #000000;
    font-size: 64px;
    font-weight: 800;
    letter-spacing: 2px;
  }
  .intro-overlay.typewriter.fade-out { animation: typewriter-fade 0.3s ease-out forwards; }
  @keyframes cursor-blink { 50% { opacity: 0; } }
  @keyframes typewriter-fade { to { opacity: 0; } }
  {% else %}
  @keyframes cursor-blink { 50% { opacity: 0; } }
  {% endif %}
</style>
</head>
<body>
  <!-- 片头声明卡 -->
  <div class="disclaimer-card" id="__disclaimer__">
    <div class="disclaimer-title">AI 生成</div>
    <div class="disclaimer-text">{{ disclaimer_text }}</div>
  </div>

  {% if intro_effect != "none" %}
  <!-- 开头特效层 -->
  <div class="intro-overlay intro-{{ intro_effect }}" id="__intro__">
    {% if intro_effect == "scanline" %}
      <div class="intro-line"></div>
      <div class="intro-mask"></div>
    {% elif intro_effect == "typewriter" %}
      <div class="intro-typewriter-text" id="intro-typewriter-text"></div>
    {% endif %}
  </div>
  {% endif %}

  <!-- 顶部标题栏 -->
  <div class="theater-header">
    <div class="theater-title" id="theater-title">{% if intro_effect != "typewriter" %}{{ title }}{% endif %}</div>
  </div>

  <!-- 聊天区 -->
  <div class="chat-wrap" id="chat-wrap">
    <div class="chat-inner" id="chat-inner">
      {% macro reply_quote(m) %}
        {% if m.reply_to_dom_id %}
          <div class="reply-quote" data-reply-to="{{ m.reply_to_dom_id }}">
            <div class="reply-quote-sender">{{ m.reply_to_sender_name }}</div>
            <div class="reply-quote-text">{{ m.reply_to_text[:30] }}{% if (m.reply_to_text | length) > 30 %}…{% endif %}</div>
          </div>
        {% endif %}
      {% endmacro %}
      {% for m in messages %}
        {% if m.kind == 'sys' %}
          <div class="sys-msg" id="{{ m.dom_id }}">{{ m.text }}</div>
        {% elif m.kind == 'timestamp' %}
          <div class="time-stamp" id="{{ m.dom_id }}">{{ m.text }}</div>
        {% elif m.kind == 'emoji' %}
          <div class="msg emoji {{ m.css_class }}" id="{{ m.dom_id }}">
            {% if m.sender_avatar %}
              <div class="avatar" style="background-image: url('{{ m.sender_avatar }}');"></div>
            {% else %}
              <div class="avatar avatar-default">{{ m.sender_name[0] if m.sender_name else '?' }}</div>
            {% endif %}
            <div class="body">
              {% if m.show_name %}<div class="sender-row"><span class="sender">{{ m.sender_name }}</span></div>{% endif %}
              {{ reply_quote(m) }}
              <div class="bubble"><span class="emoji-text">{{ m.text }}</span></div>
            </div>
          </div>
        {% elif m.kind == 'image' %}
          <div class="msg {{ m.css_class }}" id="{{ m.dom_id }}">
            {% if m.sender_avatar %}
              <div class="avatar" style="background-image: url('{{ m.sender_avatar }}');"></div>
            {% else %}
              <div class="avatar avatar-default">{{ m.sender_name[0] if m.sender_name else '?' }}</div>
            {% endif %}
            <div class="body">
              {% if m.show_name %}<div class="sender-row"><span class="sender">{{ m.sender_name }}</span></div>{% endif %}
              {{ reply_quote(m) }}
              <div class="bubble img-bubble">
                <div class="img-wrap"><img src="{{ m.image_url }}" alt="{{ m.text or '' }}"></div>
                {% if m.text %}<div class="img-caption">{{ m.text }}</div>{% endif %}
              </div>
            </div>
          </div>
        {% elif m.kind == 'video' %}
          <div class="msg {{ m.css_class }}" id="{{ m.dom_id }}">
            {% if m.sender_avatar %}
              <div class="avatar" style="background-image: url('{{ m.sender_avatar }}');"></div>
            {% else %}
              <div class="avatar avatar-default">{{ m.sender_name[0] if m.sender_name else '?' }}</div>
            {% endif %}
            <div class="body">
              {% if m.show_name %}<div class="sender-row"><span class="sender">{{ m.sender_name }}</span></div>{% endif %}
              {{ reply_quote(m) }}
              <div class="bubble video-bubble">
                <img class="video-cover" src="{{ m.cover_url or m.video_url }}" alt="">
                <div class="video-play"></div>
                <div class="video-duration">{{ m.duration }}</div>
              </div>
            </div>
          </div>
        {% else %}
          <div class="msg {{ m.css_class }}" id="{{ m.dom_id }}">
            {% if m.sender_avatar %}
              <div class="avatar" style="background-image: url('{{ m.sender_avatar }}');"></div>
            {% else %}
              <div class="avatar avatar-default">{{ m.sender_name[0] if m.sender_name else '?' }}</div>
            {% endif %}
            <div class="body">
              {% if m.show_name %}<div class="sender-row"><span class="sender">{{ m.sender_name }}</span></div>{% endif %}
              {{ reply_quote(m) }}
              <div class="bubble">{{ m.text | replace('\n', '<br>') | safe }}</div>
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>

  <!-- AI 角标 -->
  <div class="ai-badge {{ ai_badge_style }}">{{ watermark_text }}</div>

<script>
  const TIMELINE = {{ timeline | tojson }};
  const TYPEWRITER_TITLE = {{ title | tojson }};
  const TYPEWRITER_INITIAL_MS = {{ typewriter_initial_ms }};
  const TYPEWRITER_PER_CHAR_MS = {{ typewriter_per_char_ms }};
  const chatWrap = document.getElementById('chat-wrap');
  const chatInner = document.getElementById('chat-inner');

  function typewriteInto(el, text, initialMs, perCharMs, onDone) {
    el.textContent = '';
    setTimeout(() => {
      let i = 0;
      function next() {
        if (i < text.length) {
          el.textContent += text[i];
          i++;
          setTimeout(next, perCharMs);
        } else if (onDone) {
          onDone();
        }
      }
      next();
    }, initialMs);
  }

  // typewriteTitle 兼容旧调用 —— 把动画写到原标题栏。
  function typewriteTitle(el, text, initialMs, perCharMs, onDone) {
    typewriteInto(el, text, initialMs, perCharMs, onDone);
  }

  function currentShift() {
    const m = chatInner.style.transform.match(/translateY\((-?[\d.]+)px\)/);
    return m ? parseFloat(m[1]) : 0;
  }

  function scrollToShow(el) {
    if (!el) return;
    const wrapRect = chatWrap.getBoundingClientRect();
    const elRect = el.getBoundingClientRect();
    const overflow = elRect.bottom - wrapRect.bottom;
    if (overflow > 0) {
      chatInner.style.transform = 'translateY(-' + (Math.abs(currentShift()) + overflow) + 'px)';
    }
  }

  function autoScroll(el) {
    if (!el) return;
    scrollToShow(el);
    el.querySelectorAll('img').forEach(img => {
      if (!img.complete) {
        img.addEventListener('load', () => scrollToShow(el), { once: true });
      }
    });
  }

  window.addEventListener('load', () => {
    setTimeout(() => {
      TIMELINE.forEach(t => setTimeout(() => {
        const el = document.getElementById(t.id);
        if (!el) return;
        if (t.type === 'disclaimer') {
          el.classList.add('hide');
          return;
        }
        if (t.type === 'intro') {
          el.classList.add('start');
          if (t.effect === 'typewriter') {
            const headerTitleEl = document.getElementById('theater-title');
            const introTitleEl = document.getElementById('intro-typewriter-text');
            // 打字机整段同时写入头栏与 intro-overlay(后者抠像后会消失)
            const totalLen = TYPEWRITER_TITLE.length;
            const advance = () => {
              const partial = TYPEWRITER_TITLE.slice(0, i + 1);
              if (headerTitleEl) headerTitleEl.textContent = partial;
              if (introTitleEl) introTitleEl.textContent = partial;
              i++;
              if (i < totalLen) {
                setTimeout(advance, TYPEWRITER_PER_CHAR_MS);
              } else {
                setTimeout(() => {
                  if (headerTitleEl) headerTitleEl.classList.remove('typewriter');
                  el.classList.add('fade-out');
                  setTimeout(() => el.classList.add('done'), 300);
                }, TYPEWRITER_PER_CHAR_MS);
              }
            };
            let i = -1;
            setTimeout(advance, TYPEWRITER_INITIAL_MS);
          } else {
            setTimeout(() => el.classList.add('done'), {{ intro_duration_ms }});
          }
          return;
        }
        el.classList.add('show');
        setTimeout(() => autoScroll(el), 250);
      }, t.at));
    }, 300);
  });
</script>
</body>
</html>
