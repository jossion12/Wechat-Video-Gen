<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<title>Chat Mockup — WeChat style</title>
<style>
  /* ---- 基础 ---- */
  * { margin: 0; padding: 0; box-sizing: border-box;
      -webkit-font-smoothing: antialiased; }
  html, body {
    overflow: hidden;
    background: {{ background }};
    {% if background_image_url %}
    background-image: url('{{ background_image_url }}');
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    {% endif %}
    font-family: -apple-system, "PingFang SC", "Hiragino Sans GB",
                 "Microsoft YaHei", "Noto Sans CJK SC", "Segoe UI", sans-serif;
  }
  body { width: 1080px; height: 1920px; position: relative; color: #111;
         display: flex; flex-direction: column; opacity: {{ opacity }}; }

  /* ---- 状态栏 ---- */
  .status-bar {
    height: 66px; flex: none;
    display: flex; align-items: center; justify-content: space-between;
    padding: 0 28px; font-size: 28px; color: #111; font-weight: 600;
  }
  .s-left { display: flex; align-items: center; gap: 12px; }
  .s-right { display: flex; align-items: center; gap: 6px; }
  .s-icons { display: flex; align-items: center; gap: 12px; }

  /* fluentui 图标通用容器:外层控制尺寸,内嵌 SVG 自适配 viewBox。fluentui 默认 fill #212121 */
  .s-icon-svg { display: flex; align-items: center; line-height: 0; }
  .s-icon-svg svg { display: block; fill: #111; }
  .s-icon-svg svg path { fill: inherit; }

  /* 单项适配尺寸(原手绘 SVG 是 26~44,使用填充约束后渲染一致) */
  .s-icon-26 { width: 24px; height: 24px; }
  .s-icon-bt { width: 15px; height: 24px; }
  .s-icon-wifi { width: 26px; height: 24px; }

  /* 信号条组:文字与信号条同一行、在同一个 SVG 中 (左上角融合),
     不再有“信号条上面”的独立空间 */
  .s-signal {
    display: inline-flex;
    align-items: flex-end;
    line-height: 1;
  }
  .s-signal--sub { margin-left: 18px; }
  .s-signal svg { display: block; }

  /* 电池:仅图标,不内嵌百分比文字 */
  .s-icon-battery {
    display: inline-flex; align-items: center;
    line-height: 0;
  }
  .s-icon-battery svg { width: 70px; height: 34px; }

  .s-network { display: none; } /* 移除手绘网络速度文本 */

  /* ---- 头部 ---- */
  .header {
    height: 92px; flex: none;
    display: flex; align-items: center;
    padding: 0 20px 0 12px;
    border-bottom: 1px solid rgba(0,0,0,0.06);
  }
  .header.single { height: 104px; }
  .back { width: 72px; height: 72px; display: flex; align-items: center;
          justify-content: center; cursor: pointer; }
  .back-arrow { width: 30px; height: 30px;
    border-left: 2px solid #111; border-bottom: 2px solid #111;
    transform: rotate(45deg); margin-left: 10px; }
  .title-wrap { flex: 1; display: flex; flex-direction: column; align-items: center;
                justify-content: center; min-width: 0; }
  .title-row { display: flex; align-items: center; gap: 10px; }
  .group-title { font-size: 36px; font-weight: 600; text-align: center;
                 white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .member-count { font-size: 26px; color: #888; font-weight: 500; }
  .subtitle { font-size: 22px; color: #999; margin-top: 2px; }
  .header-actions { display: flex; align-items: center; justify-content: flex-end;
                    min-width: 72px; gap: 14px; }
  .more { width: 72px; height: 40px; display: flex; align-items: center;
          justify-content: flex-end; gap: 6px; padding-right: 4px; }
  .more-dot { width: 9px; height: 9px; background: #111; border-radius: 50%; }
  .mute-bell { width: 32px; height: 32px; position: relative; }
  .mute-bell::before { content: ""; position: absolute; left: 50%; top: 2px;
    width: 18px; height: 18px; border: 2px solid #111; border-radius: 50% 50% 0 0;
    border-bottom: none; transform: translateX(-50%); }
  .mute-bell::after { content: ""; position: absolute; left: 50%; bottom: 3px;
    width: 20px; height: 2px; background: #111; transform: translateX(-50%); }

  /* ---- 聊天区 ---- */
  .chat-wrap { flex: 1; min-height: 0; overflow: hidden; position: relative; }
  .chat-inner { display: flex; flex-direction: column; gap: 24px;
                padding: 24px 28px 36px; min-height: 100%;
                transition: transform 0.5s ease-out;
                will-change: transform; }

  .time-stamp { align-self: center; background: rgba(0,0,0,0.06); color: #888;
                font-size: 24px; padding: 8px 20px; border-radius: 10px;
                opacity: 0; transform: translateY(10px);
                transition: opacity .35s ease-out, transform .35s ease-out; }
  .time-stamp.show { opacity: 1; transform: translateY(0); }

  /* ---- 聊天气泡 ---- */
  .msg { display: flex; gap: 20px; max-width: 82%; align-self: flex-start;
         opacity: 0; transform: translateY(30px) scale(0.96);
         transition: opacity .4s ease-out, transform .4s ease-out; }
  .msg.show { opacity: 1; transform: translateY(0) scale(1); }
  .msg.no-avatar { padding-left: 116px; }
  .msg.no-avatar.self { padding-left: 0; padding-right: 116px; }

  .msg .avatar { width: 96px; height: 96px; border-radius: 20px; flex: none;
                 background-size: cover; background-position: center;
                 background-color: #e3e3e3; }
  .avatar-default { position: relative; background-color: #cfcece !important; overflow: hidden; }
  .avatar-default::before { content: ""; position: absolute; left: 50%; top: 34%;
    transform: translate(-50%, -50%); width: 36px; height: 36px; border-radius: 50%;
    background: #e3e3e3; }
  .avatar-default::after { content: ""; position: absolute; left: 50%; top: 78%;
    transform: translate(-50%, -50%); width: 72px; height: 44px;
    border-radius: 50% / 55%; background: #e3e3e3; }

  .msg .body { display: flex; flex-direction: column; align-items: flex-start;
               min-width: 0; justify-content: center; }
  .sender-row { display: flex; align-items: center; gap: 8px; margin-bottom: 8px; }
  .sender { font-size: 24px; color: #666; }
  .sender-label { font-size: 22px; color: #888; }

  .bubble { position: relative; max-width: 100%; background: #ffffff;
            border-radius: 12px; padding: 20px 26px;
            font-size: 40px; line-height: 1.45; color: #1a1c1f;
            word-break: break-word; }
  .bubble::before { content: ""; position: absolute; left: -10px; top: 26px;
    border: 10px solid transparent; border-right-color: #ffffff;
    border-left: 0; border-bottom: 0; }
  .bubble.text-only { min-width: 0; }

  /* 自己(右侧,绿色) */
  .msg.self { flex-direction: row-reverse; align-self: flex-end; }
  .msg.self .body { align-items: flex-end; }
  .msg.self .bubble { background: #95ec69; color: #1a1c1f;
                      border-radius: 12px 12px 4px 12px; }
  .msg.self .bubble::before { left: auto; right: -10px;
    border-right: none; border-left: 12px solid #95ec69; }
  .msg.self .sender-row { display: none; }

  /* 单独表情消息 */
  .msg.emoji .bubble { background: transparent !important; padding: 0; box-shadow: none; }
  .msg.emoji .bubble::before { display: none; }
  .msg.emoji .emoji-text { font-size: 120px; line-height: 1; }
  .msg.emoji.self { align-self: flex-end; }

  /* 图片消息 */
  .img-bubble { padding: 12px; }
  .img-wrap { overflow: hidden; border-radius: 8px; }
  .img-wrap img { display: block; max-width: 500px; max-height: 680px;
                  width: auto; height: auto; border-radius: 8px;
                  object-fit: contain; }
  .img-caption { padding: 16px 8px 4px; font-size: 38px; line-height: 1.4;
                 color: #333; max-width: 480px; word-break: break-word; }

  /* 视频消息 */
  .video-bubble { padding: 0; overflow: hidden; border-radius: 12px;
                  position: relative; max-width: 500px; background: #000; }
  .video-bubble .video-cover { display: block; width: 500px; min-height: 280px;
                               max-height: 680px; object-fit: cover; border-radius: 12px; }
  .video-play { position: absolute; left: 50%; top: 50%;
                width: 96px; height: 96px; background: rgba(0,0,0,0.45);
                border-radius: 50%; transform: translate(-50%, -50%);
                display: flex; align-items: center; justify-content: center; }
  .video-play::before { content: ""; width: 0; height: 0;
    border-left: 34px solid #fff; border-top: 22px solid transparent;
    border-bottom: 22px solid transparent; margin-left: 10px; }
  .video-duration { position: absolute; right: 18px; bottom: 18px;
                    background: rgba(0,0,0,0.35); color: #fff;
                    font-size: 26px; padding: 4px 12px; border-radius: 8px; }

  /* 系统消息 */
  .sys-msg { align-self: center; background: rgba(0,0,0,0.08); color: #666;
             font-size: 28px; line-height: 1.5; padding: 12px 26px;
             border-radius: 12px; max-width: 80%; text-align: center;
             opacity: 0; transform: translateY(20px);
             transition: opacity .4s ease-out, transform .4s ease-out; }
  .sys-msg.show { opacity: 1; transform: translateY(0); }
  .sys-msg.flash { animation: sys-flash 1.3s ease-out; }
  @keyframes sys-flash {
    0%   { box-shadow: 0 0 0 0 rgba(255, 59, 48, 0.55); background: #ffe9e6;
           color: #e64340; }
    45%  { box-shadow: 0 0 0 30px rgba(255, 59, 48, 0); }
    60%  { box-shadow: 0 0 0 14px rgba(255, 59, 48, 0.32); background: #ffe9e6;
           color: #e64340; }
    100% { box-shadow: 0 0 0 0 rgba(255, 59, 48, 0); }
  }

  /* ---- 输入栏 ---- */
  .input-bar { height: 152px; flex: none; display: flex; align-items: center;
               gap: 26px; padding: 0 28px; background: #f7f7f7;
               border-top: 1px solid rgba(0,0,0,0.08); }
  .ib-btn { width: 56px; height: 56px; flex: none; display: flex;
            align-items: center; justify-content: center; }
  .ib-btn svg { display: block; }
  .ib-input { flex: 1; height: 84px; background: #fff; border-radius: 12px;
              border: 1px solid rgba(0,0,0,0.08); padding: 0 26px;
              font-size: 38px; color: #333; display: flex; align-items: center; }

  /* ---- 底部手势条 ---- */
  .home-indicator { height: 44px; flex: none; background: #f7f7f7;
                    display: flex; align-items: center; justify-content: center; }
  .home-indicator::before { content: ""; width: 280px; height: 8px;
    background: #b0b0b0; border-radius: 4px; }

  /* ---- 水印层 ---- */
  .watermark-layer {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    pointer-events: none;
    z-index: 9999;
    overflow: hidden;
  }
  .float-watermark {
    position: absolute;
    font-size: 32px;
    font-weight: 500;
    color: rgba(0, 0, 0, 0.12);
    white-space: nowrap;
    transform: rotate(-15deg);
    text-shadow: 0 1px 2px rgba(255, 255, 255, 0.4);
    animation: floatMove 10s ease-in-out infinite;
  }
  @keyframes floatMove {
    0%   { top: 12%; left: 8%; }
    20%  { top: 78%; left: 72%; }
    40%  { top: 62%; left: 18%; }
    60%  { top: 22%; left: 82%; }
    80%  { top: 86%; left: 44%; }
    100% { top: 12%; left: 8%; }
  }
  .ai-watermark {
    position: absolute;
    right: 24px;
    bottom: 68px;
    font-size: 24px;
    font-weight: 500;
    color: rgba(0, 0, 0, 0.22);
    white-space: nowrap;
    text-shadow: 0 1px 2px rgba(255, 255, 255, 0.5);
  }
</style>
</head>
<body>
  <!-- 状态栏 -->
  <div class="status-bar">
    <span class="s-left">
      <span class="s-time">{{ status_bar.time }}</span>
    </span>
    <span class="s-right">
      {% if status_bar.show_alarm %}
      <span class="s-icon-svg s-icon-26">{{ icons.alarm | safe }}</span>
      {% endif %}
      {% if status_bar.show_bluetooth %}
      <span class="s-icon-svg s-icon-bt">{{ icons.bluetooth | safe }}</span>
      {% endif %}
      {% if status_bar.show_wifi %}
      <span class="s-icon-svg s-icon-wifi">{{ icons.wifi | safe }}</span>
      {% endif %}
      {% if status_bar.show_signal %}
      <span class="s-signal">
        <svg width="36" height="20" viewBox="0 0 48 22">
          {% if status_bar.signal_type %}<text x="0" y="15" font-size="13" font-weight="800" fill="#111" letter-spacing="-0.5">{{ status_bar.signal_type }}</text>{% endif %}
          <rect x="22" y="14" width="6" height="6" rx="1" fill="#111"/>
          <rect x="29" y="10" width="6" height="10" rx="1" fill="#111"/>
          <rect x="36" y="6" width="6" height="14" rx="1" fill="#111"/>
          <rect x="43" y="2" width="6" height="18" rx="1" fill="#111"/>
        </svg>
      </span>
      {% endif %}
      {% if status_bar.dual_sim %}
      <span class="s-signal s-signal--sub">
        <svg width="36" height="20" viewBox="0 0 48 22">
          <text x="0" y="15" font-size="13" font-weight="800" fill="#111" letter-spacing="-0.5">{{ status_bar.signal_type_secondary or status_bar.signal_type or '5G' }}</text>
          <rect x="22" y="14" width="6" height="6" rx="1" fill="#111"/>
          <rect x="29" y="10" width="6" height="10" rx="1" fill="#111"/>
          <rect x="36" y="6" width="6" height="14" rx="1" fill="#111"/>
          <rect x="43" y="2" width="6" height="18" rx="1" fill="#111"/>
        </svg>
      </span>
      {% endif %}
      <span class="s-icon-svg s-icon-battery">
        {{ icons[battery_icon] | safe }}
      </span>
    </span>
  </div>

  <!-- 头部 -->
  <div class="header {{ 'single' if mode == 'single' else 'group' }}">
    <div class="back"><div class="back-arrow"></div></div>
    <div class="title-wrap">
      <div class="title-row">
        <div class="group-title">{{ title }}</div>
        {% if mode == 'group' and member_count is not none %}
        <div class="member-count">({{ member_count }})</div>
        {% endif %}
      </div>
      {% if mode == 'single' and subtitle %}
      <div class="subtitle">{{ subtitle }}</div>
      {% endif %}
    </div>
    <div class="header-actions">
      {% if mode == 'group' and muted %}<div class="mute-bell"></div>{% endif %}
      <div class="more">
        <span class="more-dot"></span>
        <span class="more-dot"></span>
        <span class="more-dot"></span>
      </div>
    </div>
  </div>

  <!-- 聊天区 -->
  <div class="chat-wrap" id="chat-wrap">
    <div class="chat-inner" id="chat-inner">
      {% for m in messages %}
        {% if m.kind == 'sys' %}
          <div class="sys-msg {{ 'flash' if m.flash else '' }}" id="{{ m.dom_id }}">{{ m.text }}</div>
        {% elif m.kind == 'timestamp' %}
          <div class="time-stamp" id="{{ m.dom_id }}">{{ m.text }}</div>
        {% elif m.kind == 'emoji' %}
          <div class="msg emoji {{ m.css_class }} {{ 'no-avatar' if not m.show_avatar else '' }}" id="{{ m.dom_id }}">
            {% if m.show_avatar %}
              {% if m.sender_avatar %}
              <div class="avatar" style="background-image: url('{{ m.sender_avatar }}');"></div>
              {% else %}
              <div class="avatar avatar-default"></div>
              {% endif %}
            {% endif %}
            <div class="body">
              {% if m.show_name %}<div class="sender-row"><span class="sender">{{ m.sender_name }}</span>{% if m.label %}<span class="sender-label">{{ m.label }}</span>{% endif %}</div>{% endif %}
              <div class="bubble"><span class="emoji-text">{{ m.text }}</span></div>
            </div>
          </div>
        {% elif m.kind == 'image' %}
          <div class="msg {{ m.css_class }} {{ 'no-avatar' if not m.show_avatar else '' }}" id="{{ m.dom_id }}">
            {% if m.show_avatar %}
              {% if m.sender_avatar %}
              <div class="avatar" style="background-image: url('{{ m.sender_avatar }}');"></div>
              {% else %}
              <div class="avatar avatar-default"></div>
              {% endif %}
            {% endif %}
            <div class="body">
              {% if m.show_name %}<div class="sender-row"><span class="sender">{{ m.sender_name }}</span>{% if m.label %}<span class="sender-label">{{ m.label }}</span>{% endif %}</div>{% endif %}
              <div class="bubble img-bubble">
                <div class="img-wrap">
                  <img src="{{ m.image_url }}" alt="{{ m.text or '' }}">
                </div>
                {% if m.text %}<div class="img-caption">{{ m.text }}</div>{% endif %}
              </div>
            </div>
          </div>
        {% elif m.kind == 'video' %}
          <div class="msg {{ m.css_class }} {{ 'no-avatar' if not m.show_avatar else '' }}" id="{{ m.dom_id }}">
            {% if m.show_avatar %}
              {% if m.sender_avatar %}
              <div class="avatar" style="background-image: url('{{ m.sender_avatar }}');"></div>
              {% else %}
              <div class="avatar avatar-default"></div>
              {% endif %}
            {% endif %}
            <div class="body">
              {% if m.show_name %}<div class="sender-row"><span class="sender">{{ m.sender_name }}</span>{% if m.label %}<span class="sender-label">{{ m.label }}</span>{% endif %}</div>{% endif %}
              <div class="bubble video-bubble">
                <img class="video-cover" src="{{ m.cover_url or m.video_url }}" alt="">
                <div class="video-play"></div>
                <div class="video-duration">{{ m.duration }}</div>
              </div>
            </div>
          </div>
        {% else %}
          <div class="msg {{ m.css_class }} {{ 'no-avatar' if not m.show_avatar else '' }}" id="{{ m.dom_id }}">
            {% if m.show_avatar %}
              {% if m.sender_avatar %}
              <div class="avatar" style="background-image: url('{{ m.sender_avatar }}');"></div>
              {% else %}
              <div class="avatar avatar-default"></div>
              {% endif %}
            {% endif %}
            <div class="body">
              {% if m.show_name %}<div class="sender-row"><span class="sender">{{ m.sender_name }}</span>{% if m.label %}<span class="sender-label">{{ m.label }}</span>{% endif %}</div>{% endif %}
              <div class="bubble">{{ m.text | replace('\n', '<br>') | safe }}</div>
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>

  <!-- 输入栏 -->
  <div class="input-bar">
    <div class="ib-btn ib-voice">
      <svg width="42" height="42" viewBox="0 0 42 42">
        <rect x="12" y="8" width="18" height="22" rx="9" fill="none" stroke="#666" stroke-width="2.5"/>
        <path d="M21 30v5" stroke="#666" stroke-width="2.5" stroke-linecap="round"/>
        <path d="M15 34h12" stroke="#666" stroke-width="2.5" stroke-linecap="round"/>
      </svg>
    </div>
    <div class="ib-input"></div>
    <div class="ib-btn ib-emoji">
      <svg width="46" height="46" viewBox="0 0 46 46">
        <circle cx="23" cy="23" r="20" fill="none" stroke="#666" stroke-width="2.5"/>
        <circle cx="17" cy="20" r="2.5" fill="#666"/>
        <circle cx="29" cy="20" r="2.5" fill="#666"/>
        <path d="M15 28 Q23 35 31 28" fill="none" stroke="#666" stroke-width="2.5" stroke-linecap="round"/>
      </svg>
    </div>
    <div class="ib-btn ib-plus">
      <svg width="42" height="42" viewBox="0 0 42 42">
        <rect x="3" y="3" width="36" height="36" rx="9" fill="none" stroke="#666" stroke-width="2"/>
        <path d="M12 21h18 M21 12v18" stroke="#666" stroke-width="2.5" stroke-linecap="round"/>
      </svg>
    </div>
  </div>

  <!-- 底部手势条 -->
  <div class="home-indicator"></div>

  <!-- 水印层 -->
  <div class="watermark-layer">
    {% if show_float_watermark %}
    <div class="float-watermark">{{ watermark_text }}</div>
    {% endif %}
    <div class="ai-watermark">AI生成</div>
  </div>

<script>
  const TIMELINE = {{ timeline | tojson }};
  const chatWrap = document.getElementById('chat-wrap');
  const chatInner = document.getElementById('chat-inner');

  function currentShift() {
    const m = chatInner.style.transform.match(/translateY\((-?[\d.]+)px\)/);
    return m ? parseFloat(m[1]) : 0;
  }

  function scrollToShow(el) {
    if (!el) return;
    const wrapRect = chatWrap.getBoundingClientRect();
    const elRect = el.getBoundingClientRect();
    const overflow = elRect.bottom - wrapRect.bottom;
    if (overflow > 0) {
      chatInner.style.transform = 'translateY(-' + (Math.abs(currentShift()) + overflow) + 'px)';
    }
  }

  function autoScroll(el) {
    if (!el) return;
    scrollToShow(el);
    // 图片/视频封面异步加载后会撑高内容，加载完成后再滚一次
    el.querySelectorAll('img').forEach(img => {
      if (!img.complete) {
        img.addEventListener('load', () => scrollToShow(el), { once: true });
      }
    });
  }

  window.addEventListener('load', () => {
    setTimeout(() => {
      TIMELINE.forEach(t => setTimeout(() => {
        const el = document.getElementById(t.id);
        if (!el) return;
        el.classList.add('show');
        if (t.type === 'sys' && t.flash) {
          setTimeout(() => el.classList.add('flash'), 120);
        }
        setTimeout(() => autoScroll(el), 250);
      }, t.at));
    }, 300);
  });
</script>
</body>
</html>
